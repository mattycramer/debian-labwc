LABEL=backup                 /data/mnt/g-drive/backup/user    btrfs    rw,relatime,lazytime,compress=zstd:1,space_cache=v2,nodiscard,nodev,nosuid,noexec,nofail,x-systemd.device-timeout=5s,subvol=@backup_user 0 0

