# Torrents subvolumes (btrfs)
LABEL=torrents               /data/mnt/g-drive/torrents       btrfs    rw,noatime,lazytime,compress=none,space_cache=v2,nodiscard,nodev,nosuid,noexec,nodatacow,nofail,x-systemd.device-timeout=5s,subvol=@torrents 0 0
LABEL=torrents               /data/mnt/g-drive/torrents/complete btrfs    rw,noatime,lazytime,compress=none,space_cache=v2,nodiscard,nodev,nosuid,noexec,nodatacow,nofail,x-systemd.device-timeout=5s,subvol=@torrents_complete 0 0
LABEL=torrents               /data/mnt/g-drive/torrents/temp  btrfs    rw,noatime,lazytime,compress=none,space_cache=v2,nodiscard,nodev,nosuid,noexec,nodatacow,nofail,x-systemd.device-timeout=5s,subvol=@torrents_temp 0 0

# Storage subvolumes (btrfs)
LABEL=storage                /data/mnt/g-drive/storage        btrfs    rw,relatime,lazytime,compress=zstd:1,space_cache=v2,nodiscard,nodev,nosuid,nofail,x-systemd.device-timeout=5s,subvol=@storage 0 0

# Backup subvolumes (btrfs)
