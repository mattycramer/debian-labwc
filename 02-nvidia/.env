# Managed by labwc 01-nvidia
#
# Values in this file are parsed conservatively by install.sh. Keep assignments
# to simple KEY="value" or KEY=value entries only.

NVIDIA_INSTALL="1"
NVIDIA_APT_TARGET_SUITE=""

# auto:
#   bookworm host -> debian12 upstream repo
#   trixie host   -> debian13 upstream repo
#
# You may explicitly force debian12 on a trixie host as a compatibility
# override. The installer will refuse unsupported combinations.
NVIDIA_UPSTREAM_DISTRO="auto"

# proprietary:
#   installs NVIDIA's upstream cuda-drivers meta package
# open:
#   installs NVIDIA's upstream nvidia-open meta package
#
# NVIDIA documents the open kernel modules as the preferred path on Turing and
# newer GPUs. Older Maxwell, Pascal, and Volta GPUs still require the
# proprietary flavor.
NVIDIA_KERNEL_MODULE_FLAVOR="proprietary"

# NVIDIA upstream APT pin package handling:
#   auto                        -> resolve the exact pin package that matches the
#                                  current upstream driver meta-package version
#   nvidia-driver-pinning-595   -> pin to a branch
#   nvidia-driver-pinning-595.58.03 -> pin to an exact driver version
#
# Keeping this at auto ensures the NVIDIA driver stack is sourced from NVIDIA's
# upstream repository instead of Debian's archive packages.
NVIDIA_DRIVER_PIN_PACKAGE="auto"

# Latest stable toolkit track by default. If you want to stay within a major or
# exact branch, change this to something like cuda-toolkit-13 or cuda-toolkit-13-2.
CUDA_TOOLKIT_PACKAGE="cuda-toolkit"

# Debian archive policy is external to this module. The host must already have
# Debian contrib enabled, and 00-system must already have the sid archive
# configured, before running the NVIDIA installer. Debian-side prerequisites are
# installed with `apt -t sid install ...`. The NVIDIA upstream archive itself is
# normalized to a deb822 `cuda-*.sources` file, and any legacy `cuda-*.list`
# entry is rewritten away during the repo phase.

# Install switcheroo-control from the preconfigured Debian sid archive so
# applications can be launched with `switcherooctl launch ...` while Intel/iHD
# remains the default path. Do not export PRIME or GBM environment variables
# globally. `02-labwc` also installs it; the duplicate install is intentional
# there.
NVIDIA_INSTALL_SWITCHEROO_CONTROL="1"

# Required for GBM-based Wayland compositors with the NVIDIA driver.
NVIDIA_ENABLE_DRM_MODESET="1"
