<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>org.gnome.FileRoller</icon>
    <name>Extract Here</name>
    <submenu></submenu>
    <unique-id>1700000000000001-1</unique-id>
    <command>/usr/local/bin/thunar-extract-here %f</command>
    <description>Extract the selected archive into a new folder named after the archive</description>
    <patterns>*.7z;*.apk;*.ar;*.cab;*.cpio;*.deb;*.gz;*.iso;*.lz;*.lz4;*.lzma;*.rar;*.rpm;*.tar;*.tar.bz2;*.tar.gz;*.tar.lz;*.tar.lz4;*.tar.lzma;*.tar.xz;*.tar.zst;*.tbz;*.tbz2;*.tgz;*.txz;*.tzst;*.xz;*.zip;*.zst</patterns>
    <other-files/>
    <range>1-1</range>
  </action>
</actions>
