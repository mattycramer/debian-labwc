#!/bin/sh
set -eu
IFS='
	'

export XDG_CURRENT_DESKTOP=labwc:wlroots

current_uid="$(id -u)"

wait_for_wayland_display() {
  display_name="${WAYLAND_DISPLAY:-wayland-0}"
  display_socket="${XDG_RUNTIME_DIR:-/run/user/${current_uid}}/${display_name}"
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if [ -S "$display_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_session_bus() {
  bus_socket="${XDG_RUNTIME_DIR:-/run/user/${current_uid}}/bus"
  attempt=1
  while [ "$attempt" -le 10 ]; do
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "$bus_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_system_bus() {
  bus_socket="/run/dbus/system_bus_socket"
  attempt=1
  while [ "$attempt" -le 10 ]; do
    if [ -S "$bus_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

warm_polkit_service() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi
  attempt=1
  while [ "$attempt" -le 10 ]; do
    systemctl start polkit.service >/dev/null 2>&1 || true
    if systemctl is-active --quiet polkit.service >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

update_activation_environment() {
  if [ "${LABWC_UPDATE_ACTIVATION_ENV:-0}" != "1" ]; then
    return 0
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment "$@" >/dev/null 2>&1 || true
  fi
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "$@" >/dev/null 2>&1 || true
  fi
}

start_bg_once() {
  process_name="$1"
  shift
  if ! command -v "$1" >/dev/null 2>&1; then
    return 0
  fi
  if pgrep -u "$current_uid" -x "$process_name" >/dev/null 2>&1; then
    return 0
  fi
  "$@" >/dev/null 2>&1 &
}

wait_for_wayland_display || true
start_bg_once foot foot --server
start_bg_once swaybg swaybg -i "@BACKGROUND_WALLPAPER_PATH@" -m "@WALLPAPER_MODE@"

wait_for_session_bus || true
wait_for_system_bus || true
update_activation_environment \
  DISPLAY \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE \
  XDG_SESSION_DESKTOP \
  DESKTOP_SESSION \
  XCURSOR_THEME \
  XCURSOR_SIZE \
  GPG_TTY \
  SSH_AUTH_SOCK \
  PASSWORD_STORE \
  ELECTRON_OZONE_PLATFORM_HINT \
  QT_QPA_PLATFORM \
  QT_WAYLAND_DISABLE_WINDOWDECORATION

warm_polkit_service || true
if ! pgrep -u "$current_uid" -f '/polkit-kde-authentication-agent-1([[:space:]]|$)' >/dev/null 2>&1; then
  /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &
fi
/usr/local/bin/labwc-workspace-state 1 >/dev/null 2>&1 || true
if [ ! -f "@TARGET_HOME@/.config/labwc-session/.outputs-refined" ]; then
  /usr/local/bin/labwc-refresh-outputs >/dev/null 2>&1 || true
else
  start_bg_once kanshi kanshi
fi
start_bg_once mako mako
start_bg_once waybar waybar --config "@TARGET_HOME@/.config/waybar/config.jsonc" --style "@TARGET_HOME@/.config/waybar/style.css"
if command -v /usr/local/bin/labwc-unlock-gpg-key >/dev/null 2>&1; then
  (
    sleep 1
    /usr/local/bin/labwc-unlock-gpg-key
  ) >/dev/null 2>&1 &
fi
if ! pgrep -u "$current_uid" -x swayidle >/dev/null 2>&1; then
  swayidle \
  timeout "@IDLE_LOCK_SECONDS@" '/usr/local/bin/labwc-lock' \
  timeout "@IDLE_DPMS_SECONDS@" '/usr/local/bin/labwc-dpms off' \
  resume '/usr/local/bin/labwc-dpms on' \
  before-sleep '/usr/local/bin/labwc-lock' >/dev/null 2>&1 &
fi

autostart_dir="@TARGET_HOME@/.config/labwc/autostart.d"
if [ -d "$autostart_dir" ]; then
  find "$autostart_dir" -maxdepth 1 -type f -name '*.sh' | sort | while IFS= read -r autostart_fragment; do
    [ -n "$autostart_fragment" ] || continue
    "$autostart_fragment" >/dev/null 2>&1 || true
  done
fi
