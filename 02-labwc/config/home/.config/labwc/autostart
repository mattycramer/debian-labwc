#!/bin/sh
set -eu
IFS='
	'

export XDG_CURRENT_DESKTOP=labwc:wlroots

current_uid="$(id -u)"

wait_for_wayland_display() {
  display_name="${WAYLAND_DISPLAY:-wayland-0}"
  display_socket="${XDG_RUNTIME_DIR:-/run/user/${current_uid}}/${display_name}"
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if [ -S "$display_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_session_bus() {
  bus_socket="${XDG_RUNTIME_DIR:-/run/user/${current_uid}}/bus"
  attempt=1
  while [ "$attempt" -le 10 ]; do
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "$bus_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_system_bus() {
  bus_socket="/run/dbus/system_bus_socket"
  attempt=1
  while [ "$attempt" -le 10 ]; do
    if [ -S "$bus_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

collect_dbus_activation_vars() {
  dbus_vars=""
  dbus_var_name=""
  dbus_var_value=""
  for dbus_var_name in "$@"; do
    eval "dbus_var_value=\${$dbus_var_name+x}"
    [ "$dbus_var_value" = "x" ] || continue
    if [ -n "$dbus_vars" ]; then
      dbus_vars="$dbus_vars $dbus_var_name"
    else
      dbus_vars="$dbus_var_name"
    fi
  done
  printf '%s\n' "$dbus_vars"
}

update_dbus_activation_environment() {
  dbus_vars="$(collect_dbus_activation_vars "$@")"
  dbus_attempt=1
  dbus_max_attempts=10
  if ! command -v /usr/bin/dbus-update-activation-environment >/dev/null 2>&1; then
    return 0
  fi
  [ -n "$dbus_vars" ] || return 0

  while [ "$dbus_attempt" -le "$dbus_max_attempts" ]; do
    # shellcheck disable=SC2086
    if /usr/bin/dbus-update-activation-environment $dbus_vars >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    dbus_attempt=$((dbus_attempt + 1))
  done

  printf '%s\n' "WARN: dbus activation environment sync failed after ${dbus_max_attempts} attempts." >&2
  return 0
}

update_systemd_activation_environment() {
  dbus_vars="$(collect_dbus_activation_vars "$@")"
  dbus_attempt=1
  dbus_max_attempts=10
  if ! command -v /usr/bin/dbus-update-activation-environment >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v /usr/bin/systemctl >/dev/null 2>&1; then
    return 0
  fi
  [ -n "$dbus_vars" ] || return 0

  while [ "$dbus_attempt" -le "$dbus_max_attempts" ]; do
    if /usr/bin/systemctl --user show-environment >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      if /usr/bin/dbus-update-activation-environment --systemd $dbus_vars >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 1
    dbus_attempt=$((dbus_attempt + 1))
  done

  printf '%s\n' "WARN: systemd activation environment sync failed after ${dbus_max_attempts} attempts." >&2
  return 0
}

start_bg_once() {
  process_name="$1"
  shift
  if ! command -v "$1" >/dev/null 2>&1; then
    return 0
  fi
  if pgrep -u "$current_uid" -x "$process_name" >/dev/null 2>&1; then
    return 0
  fi
  "$@" >/dev/null 2>&1 &
}

wait_for_wayland_display || true
start_bg_once foot foot --server
start_bg_once swaybg swaybg -i "@BACKGROUND_WALLPAPER_PATH@" -m "@WALLPAPER_MODE@"

wait_for_session_bus || true
wait_for_system_bus || true
update_dbus_activation_environment \
  WAYLAND_DISPLAY \
  DISPLAY \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE \
  XDG_SESSION_DESKTOP \
  DESKTOP_SESSION \
  XCURSOR_THEME \
  XCURSOR_SIZE \
  GDK_BACKEND \
  CLUTTER_BACKEND \
  SDL_VIDEODRIVER \
  _JAVA_AWT_WM_NONREPARENTING \
  GTK_A11Y \
  NO_AT_BRIDGE \
  MOZ_ENABLE_WAYLAND \
  MOZ_WEBRENDER \
  LIBVA_DRIVER_NAME \
  LIBVA_DRI_DRIVER_NAME \
  QT_QPA_PLATFORMTHEME \
  QT_AUTO_SCREEN_SCALE_FACTOR \
  WLR_NO_HARDWARE_CURSOR \
  PASSWORD_STORE \
  ELECTRON_OZONE_PLATFORM_HINT \
  QT_QPA_PLATFORM \
  QT_WAYLAND_DISABLE_WINDOWDECORATION \
  GPG_TTY \
  SSH_AUTH_SOCK
update_systemd_activation_environment \
  WAYLAND_DISPLAY \
  DISPLAY \
  DBUS_SESSION_BUS_ADDRESS \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE \
  XDG_SESSION_DESKTOP \
  DESKTOP_SESSION \
  XCURSOR_THEME \
  XCURSOR_SIZE \
  GDK_BACKEND \
  CLUTTER_BACKEND \
  SDL_VIDEODRIVER \
  _JAVA_AWT_WM_NONREPARENTING \
  GTK_A11Y \
  NO_AT_BRIDGE \
  MOZ_ENABLE_WAYLAND \
  MOZ_WEBRENDER \
  LIBVA_DRIVER_NAME \
  LIBVA_DRI_DRIVER_NAME \
  QT_QPA_PLATFORMTHEME \
  QT_AUTO_SCREEN_SCALE_FACTOR \
  WLR_NO_HARDWARE_CURSOR \
  PASSWORD_STORE \
  ELECTRON_OZONE_PLATFORM_HINT \
  QT_QPA_PLATFORM \
  QT_WAYLAND_DISABLE_WINDOWDECORATION \
  GPG_TTY \
  SSH_AUTH_SOCK

if ! pgrep -u "$current_uid" -f '/polkit-kde-authentication-agent-1([[:space:]]|$)' >/dev/null 2>&1; then
  /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &
fi
/usr/local/bin/labwc-workspace-state 1 >/dev/null 2>&1 || true
if [ ! -f "@TARGET_HOME@/.config/labwc-session/.outputs-refined" ]; then
  /usr/local/bin/labwc-refresh-outputs >/dev/null 2>&1 || true
else
  start_bg_once kanshi kanshi
fi
start_bg_once mako mako
if [ -x /usr/local/bin/labwc-start-waybar ]; then
  /usr/local/bin/labwc-start-waybar >/dev/null 2>&1 &
fi
if command -v /usr/local/bin/labwc-unlock-gpg-key >/dev/null 2>&1; then
  (
    sleep 1
    /usr/local/bin/labwc-unlock-gpg-key
  ) >/dev/null 2>&1 &
fi
if ! pgrep -u "$current_uid" -x swayidle >/dev/null 2>&1; then
  swayidle -w \
  timeout "@IDLE_LOCK_SECONDS@" '/usr/local/bin/labwc-lock' \
  timeout "@IDLE_DPMS_SECONDS@" '/usr/local/bin/labwc-dpms off' \
  resume '/usr/local/bin/labwc-dpms on' \
  before-sleep '/usr/local/bin/labwc-lock' >/dev/null 2>&1 &
fi

autostart_dir="@TARGET_HOME@/.config/labwc/autostart.d"
if [ -d "$autostart_dir" ]; then
  find "$autostart_dir" -maxdepth 1 -type f -name '*.sh' | sort | while IFS= read -r autostart_fragment; do
    [ -n "$autostart_fragment" ] || continue
    "$autostart_fragment" >/dev/null 2>&1 || true
  done
fi
