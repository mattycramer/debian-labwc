#!/bin/sh
set -eu

require_path() {
  path="$1"
  label="$2"
  if [ ! -e "$path" ]; then
    printf '%s\n' "ERROR: missing ${label}: ${path}" >&2
    exit 1
  fi
}

require_writable_dir() {
  path="$1"
  label="$2"
  require_path "$path" "$label"
  if [ ! -d "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not a directory: ${path}" >&2
    exit 1
  fi
  if [ ! -w "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not writable: ${path}" >&2
    exit 1
  fi
}

require_readable_file() {
  path="$1"
  label="$2"
  require_path "$path" "$label"
  if [ ! -r "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not readable: ${path}" >&2
    exit 1
  fi
}

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  printf '%s\n' "ERROR: XDG_RUNTIME_DIR is not set for the greeter session." >&2
  exit 1
fi
require_writable_dir "$XDG_RUNTIME_DIR" "greeter runtime directory"
if [ -z "${GREETD_SOCK:-}" ]; then
  printf '%s\n' "ERROR: GREETD_SOCK is not set for the greeter session." >&2
  exit 1
fi
require_path "$GREETD_SOCK" "greetd socket"
if [ ! -S "$GREETD_SOCK" ]; then
  printf '%s\n' "ERROR: greetd socket is not a UNIX socket: ${GREETD_SOCK}" >&2
  exit 1
fi
require_readable_file "/etc/greetd/regreet.toml" "regreet config"
require_readable_file "/etc/greetd/regreet.css" "regreet stylesheet"
require_writable_dir "/var/log/regreet" "regreet log directory"
require_writable_dir "/var/lib/regreet" "regreet state directory"

export GDK_BACKEND=wayland
export LIBSEAT_BACKEND=logind
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots
export XDG_SESSION_DESKTOP=labwc
export DESKTOP_SESSION=labwc
export GTK_USE_PORTAL=0
export GDK_DEBUG=no-portals
export GTK_A11Y=none
export NO_AT_BRIDGE=1
export XCURSOR_THEME="@XCURSOR_THEME@"
export XCURSOR_SIZE="@XCURSOR_SIZE@"
exec /usr/local/bin/regreet --config /etc/greetd/regreet.toml --style /etc/greetd/regreet.css
