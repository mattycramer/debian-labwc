#!/bin/sh
set -eu

timestamp() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

require_path() {
  path="$1"
  label="$2"
  if [ ! -e "$path" ]; then
    printf '%s\n' "ERROR: missing ${label}: ${path}" >&2
    exit 1
  fi
}

require_writable_dir() {
  path="$1"
  label="$2"
  require_path "$path" "$label"
  if [ ! -d "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not a directory: ${path}" >&2
    exit 1
  fi
  if [ ! -w "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not writable: ${path}" >&2
    exit 1
  fi
}

require_readable_file() {
  path="$1"
  label="$2"
  require_path "$path" "$label"
  if [ ! -r "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not readable: ${path}" >&2
    exit 1
  fi
}

require_executable_file() {
  path="$1"
  label="$2"
  require_path "$path" "$label"
  if [ ! -x "$path" ]; then
    printf '%s\n' "ERROR: ${label} is not executable: ${path}" >&2
    exit 1
  fi
}

resolve_wayland_display() {
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    printf '%s\n' "$WAYLAND_DISPLAY"
    return 0
  fi

  if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
    printf '%s\n' "wayland-0"
    return 0
  fi

  display_name=""
  display_count=0
  for socket_path in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$socket_path" ] || continue
    display_name="${socket_path##*/}"
    display_count=$((display_count + 1))
    if [ "$display_count" -gt 1 ]; then
      printf '%s\n' "ERROR: WAYLAND_DISPLAY is unset and multiple Wayland sockets exist under ${XDG_RUNTIME_DIR}." >&2
      return 2
    fi
  done

  if [ "$display_count" -eq 1 ]; then
    printf '%s\n' "$display_name"
    return 0
  fi

  return 1
}

wait_for_wayland_display() {
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if display_name="$(resolve_wayland_display)"; then
      printf '%s\n' "$display_name"
      return 0
    fi
    status=$?
    if [ "$status" -eq 2 ]; then
      return 2
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_wayland_socket() {
  display_name="$1"
  display_socket="$XDG_RUNTIME_DIR/$display_name"
  attempt=1
  while [ "$attempt" -le 20 ]; do
    if [ -S "$display_socket" ]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  printf '%s\n' "ERROR: XDG_RUNTIME_DIR is not set for the greeter session." >&2
  exit 1
fi
regreet_bin="/usr/local/bin/regreet"
regreet_config="/etc/greetd/regreet.toml"
regreet_style="/etc/greetd/regreet.css"
require_writable_dir "$XDG_RUNTIME_DIR" "greeter runtime directory"
if [ -z "${GREETD_SOCK:-}" ]; then
  printf '%s\n' "ERROR: GREETD_SOCK is not set for the greeter session." >&2
  exit 1
fi
require_path "$GREETD_SOCK" "greetd socket"
if [ ! -S "$GREETD_SOCK" ]; then
  printf '%s\n' "ERROR: greetd socket is not a UNIX socket: ${GREETD_SOCK}" >&2
  exit 1
fi
require_executable_file "$regreet_bin" "regreet binary"
require_readable_file "$regreet_config" "regreet config"
require_readable_file "$regreet_style" "regreet stylesheet"
require_writable_dir "/var/log/regreet" "regreet log directory"
require_writable_dir "/var/lib/regreet" "regreet state directory"

if ! display_name="$(wait_for_wayland_display)"; then
  status=$?
  if [ "$status" -ne 2 ]; then
    printf '%s\n' "ERROR: labwc did not expose a Wayland display under ${XDG_RUNTIME_DIR} within 20 seconds." >&2
  fi
  exit 1
fi
if ! wait_for_wayland_socket "$display_name"; then
  printf '%s\n' "ERROR: Wayland socket did not become ready for ${display_name} under ${XDG_RUNTIME_DIR}." >&2
  exit 1
fi
export WAYLAND_DISPLAY="$display_name"

# Give labwc one short grace period after the socket appears so GTK4 does not
# race the compositor's startup path on fresh greetd sessions.
printf '[%s] INFO: greeter resolved WAYLAND_DISPLAY=%s\n' "$(timestamp)" "$WAYLAND_DISPLAY" >&2
sleep 1

export GDK_BACKEND=wayland
export LIBSEAT_BACKEND=logind
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots
export XDG_SESSION_DESKTOP=labwc
export DESKTOP_SESSION=labwc
export GTK_USE_PORTAL=0
export GDK_DEBUG=no-portals
export GTK_A11Y=none
export NO_AT_BRIDGE=1
export XCURSOR_THEME="@XCURSOR_THEME@"
export XCURSOR_SIZE="@XCURSOR_SIZE@"
exec "$regreet_bin" --config "$regreet_config" --style "$regreet_style"
