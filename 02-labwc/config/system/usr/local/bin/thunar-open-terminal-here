#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

selected_path="${1:-}"
current_dir="${2:-$PWD}"
target_dir="$current_dir"

if [[ -n "$selected_path" ]]; then
  if [[ -d "$selected_path" ]]; then
    target_dir="$selected_path"
  else
    target_dir="$(dirname -- "$selected_path")"
  fi
fi

[[ -d "$target_dir" ]] || exit 1
command -v foot >/dev/null 2>&1 || exit 1

exec foot --working-directory "$target_dir"
