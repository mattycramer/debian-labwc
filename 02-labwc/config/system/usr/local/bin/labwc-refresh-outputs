#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

state_dir="$HOME/.config/labwc-session"
marker_file="$state_dir/.outputs-refined"
internal_output="@INTERNAL_OUTPUT@"
external_output="@EXTERNAL_OUTPUT@"
internal_mode_default="@INTERNAL_MODE@"
internal_hz_default="@INTERNAL_HZ@"
external_mode_default="@EXTERNAL_MODE@"
external_hz_default="@EXTERNAL_HZ@"

mkdir -p "$state_dir"

preferred_external_mode="${LABWC_EXTERNAL_PREFERRED_MODE:-1920x1080}"
preferred_external_hz="${LABWC_EXTERNAL_PREFERRED_HZ:-120}"
wlr_randr_output="$(wlr-randr 2>/dev/null || true)"

mode_width() {
  local mode_name="$1"
  if [[ "$mode_name" =~ ^([0-9]+)x[0-9]+$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  printf '%s\n' "1920"
}

detect_output_mode_hz() {
  local target_output="$1"
  local fallback_mode="$2"
  local fallback_hz="$3"
  local preferred_mode="$4"
  local preferred_hz="$5"
  local current_output="" line mode_candidate hz_candidate hz_rounded
  local preferred_mode_found="" preferred_hz_found=""
  local current_mode_found="" current_hz_found=""
  local resolved_mode="${fallback_mode:-1920x1080}"
  local resolved_hz="${fallback_hz:-60}"

  [[ -n "$target_output" ]] || {
    printf '%s|%s\n' "$resolved_mode" "$resolved_hz"
    return 0
  }

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ "$line" != ' '* ]]; then
      current_output="${line%% *}"
      continue
    fi
    [[ "$current_output" == "$target_output" ]] || continue
    mode_candidate="$(printf '%s\n' "$line" | sed -n 's/^[[:space:]]*\([0-9][0-9]*x[0-9][0-9]*\) px, .*$/\1/p')"
    hz_candidate="$(printf '%s\n' "$line" | sed -n 's/^[[:space:]]*[0-9][0-9]*x[0-9][0-9]* px, \([0-9.][0-9.]*\) Hz.*$/\1/p')"
    [[ -n "$mode_candidate" && -n "$hz_candidate" ]] || continue
    hz_rounded="$(awk -v hz="$hz_candidate" 'BEGIN { printf "%d", hz + 0.5 }')"
    if [[ -n "$preferred_mode" && -n "$preferred_hz" && "$mode_candidate" == "$preferred_mode" && "$hz_rounded" == "$preferred_hz" ]]; then
      printf '%s|%s\n' "$mode_candidate" "$preferred_hz"
      return 0
    fi
    if [[ "$line" == *"(preferred"* && -z "$preferred_mode_found" ]]; then
      preferred_mode_found="$mode_candidate"
      preferred_hz_found="$hz_rounded"
    fi
    if [[ "$line" == *"(current"* ]]; then
      current_mode_found="$mode_candidate"
      current_hz_found="$hz_rounded"
    fi
  done <<<"$wlr_randr_output"

  if [[ -n "$preferred_mode_found" && -n "$preferred_hz_found" ]]; then
    resolved_mode="$preferred_mode_found"
    resolved_hz="$preferred_hz_found"
  elif [[ -n "$current_mode_found" && -n "$current_hz_found" ]]; then
    resolved_mode="$current_mode_found"
    resolved_hz="$current_hz_found"
  fi

  printf '%s|%s\n' "$resolved_mode" "$resolved_hz"
}

IFS='|' read -r internal_mode internal_hz < <(
  detect_output_mode_hz "$internal_output" "$internal_mode_default" "$internal_hz_default" "" ""
)
IFS='|' read -r external_mode external_hz < <(
  detect_output_mode_hz "$external_output" "$external_mode_default" "$external_hz_default" "$preferred_external_mode" "$preferred_external_hz"
)

if [[ -z "$internal_output" && -z "$external_output" ]]; then
  touch "$marker_file"
  exit 0
fi

if [[ -n "$internal_output" ]]; then
  if [[ -n "$external_output" ]]; then
    external_width="$(mode_width "$external_mode")"
    cat >"$HOME/.config/kanshi/config" <<EOF
profile internal {
  output "$internal_output" mode ${internal_mode}@${internal_hz}Hz position 0,0 enable
}

profile external {
  output "$external_output" mode ${external_mode}@${external_hz}Hz position 0,0 enable
  output "$internal_output" disable
}

profile dual {
  output "$external_output" mode ${external_mode}@${external_hz}Hz position 0,0 enable
  output "$internal_output" mode ${internal_mode}@${internal_hz}Hz position ${external_width},0 enable
}
EOF
  else
    cat >"$HOME/.config/kanshi/config" <<EOF
profile internal {
  output "$internal_output" mode ${internal_mode}@${internal_hz}Hz position 0,0 enable
}
EOF
  fi
else
  cat >"$HOME/.config/kanshi/config" <<EOF
profile external {
  output "$external_output" mode ${external_mode}@${external_hz}Hz position 0,0 enable
}
EOF
fi

pkill -x kanshi >/dev/null 2>&1 || true
nohup kanshi >/dev/null 2>&1 &
touch "$marker_file"
