#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/labwc-session"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock_dir="${runtime_dir%/}/labwc-waybar.lock"
config_path="@TARGET_HOME@/.config/waybar/config.jsonc"
style_path="@TARGET_HOME@/.config/waybar/style.css"
log_path="${state_dir}/waybar.log"
display_name="${WAYLAND_DISPLAY:-wayland-0}"
display_socket="${runtime_dir%/}/${display_name}"
child_pid=""
stop_requested=0

cleanup() {
  rm -rf -- "$lock_dir"
}

request_stop() {
  stop_requested=1
  if [[ -n "${child_pid:-}" ]]; then
    kill "$child_pid" >/dev/null 2>&1 || true
  fi
}

wait_for_wayland_display() {
  local attempt=1
  while (( attempt <= 20 )); do
    if [[ -S "$display_socket" ]]; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

wait_for_outputs() {
  local attempt=1
  local outputs=""
  command -v wlr-randr >/dev/null 2>&1 || return 0
  while (( attempt <= 10 )); do
    outputs="$(wlr-randr 2>/dev/null || true)"
    if printf '%s\n' "$outputs" | grep -q '^[^[:space:]]'; then
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done
  return 1
}

mkdir -p "$state_dir"
[[ -f "$config_path" && -f "$style_path" ]] || exit 0
mkdir "$lock_dir" 2>/dev/null || exit 0

trap cleanup EXIT
trap request_stop TERM INT HUP

wait_for_wayland_display || exit 0
wait_for_outputs || true

attempt=1
while (( attempt <= 5 )); do
  printf '[%s] INFO: launching waybar attempt %d\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$attempt" >>"$log_path"
  /usr/bin/waybar --config "$config_path" --style "$style_path" >>"$log_path" 2>&1 &
  child_pid=$!
  if wait "$child_pid"; then
    child_pid=""
    exit 0
  fi
  exit_code=$?
  child_pid=""
  if (( stop_requested == 1 )); then
    exit 0
  fi
  printf '[%s] WARN: waybar exited with status %d\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$exit_code" >>"$log_path"
  if (( attempt >= 5 )); then
    exit 0
  fi
  sleep "$attempt"
  attempt=$((attempt + 1))
done
