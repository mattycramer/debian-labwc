#!/bin/sh
set -eu

runtime_bus_path=""
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  runtime_bus_path="${XDG_RUNTIME_DIR}/bus"
fi

broker_user_bus_ready() {
  [ -n "$runtime_bus_path" ] || return 1
  [ -S "$runtime_bus_path" ] || return 1

  if ! command -v /usr/bin/dbus-send >/dev/null 2>&1; then
    return 0
  fi

  DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime_bus_path}" \
    /usr/bin/dbus-send \
      --session \
      --type=method_call \
      --dest=org.freedesktop.DBus \
      /org/freedesktop/DBus \
      org.freedesktop.DBus.ListNames >/dev/null 2>&1
}

attempt=1
while [ "$attempt" -le 15 ]; do
  if broker_user_bus_ready; then
    export LABWC_SESSION_BUS_MODE=systemd
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${runtime_bus_path}"
    exec /usr/bin/labwc -C /etc/labwc-greeter -S /usr/local/bin/labwc-greeter-regreet
  fi
  sleep 1
  attempt=$((attempt + 1))
done

printf '%s\n' "ERROR: greeter systemd user bus did not appear at ${runtime_bus_path:-unknown}; refusing to start a private dbus-run-session greeter" >&2
exit 1
