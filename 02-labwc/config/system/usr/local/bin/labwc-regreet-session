#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

export HOME=/var/lib/greetd/greeter
export USER=greeter
export LOGNAME=greeter
export XDG_CACHE_HOME=/var/lib/greetd/greeter/.cache
export XDG_CONFIG_HOME=/var/lib/greetd/greeter/.config
export XDG_DATA_HOME=/var/lib/greetd/greeter/.local/share
export XDG_STATE_HOME=/var/lib/greetd/greeter/.local/state

exec labwc -C /etc/greetd/labwc -S /usr/local/bin/regreet
