# Managed package selection.
MAINTENANCE_APT_SUITE="trixie-backports"

# Upstream grub-btrfs source pinned to the reviewed commit.
GRUB_BTRFS_REPO_URL="https://github.com/Antynea/grub-btrfs.git"
GRUB_BTRFS_REPO_REF="7e8a45ca9cdd53751b5fae976c57df5a9e98fee9"
GRUB_BTRFS_LIMIT="50"
GRUB_BTRFS_SHOW_SNAPSHOTS_FOUND="false"

# Timeshift is Btrfs-only in this module.
TIMESHIFT_BTRFS_MODE="true"
TIMESHIFT_INCLUDE_BTRFS_HOME="false"
TIMESHIFT_SCHEDULE_MONTHLY="true"
TIMESHIFT_SCHEDULE_WEEKLY="true"
TIMESHIFT_SCHEDULE_DAILY="false"
TIMESHIFT_SCHEDULE_HOURLY="false"
TIMESHIFT_SCHEDULE_BOOT="false"
TIMESHIFT_COUNT_MONTHLY="2"
TIMESHIFT_COUNT_WEEKLY="3"
TIMESHIFT_COUNT_DAILY="5"
TIMESHIFT_COUNT_HOURLY="6"
TIMESHIFT_COUNT_BOOT="5"

# Timer policy.
MAINTENANCE_ENABLE_FSTRIM="yes"
MAINTENANCE_SCRUB_INTERVAL="21d"
MAINTENANCE_BALANCE_INTERVAL="63d"
MAINTENANCE_TIMER_ACCURACY_SEC="1h"
MAINTENANCE_TIMER_RANDOMIZED_DELAY_SEC="6h"

# >>> AUTOGENERATED: DO NOT EDIT >>>
MAINTENANCE_TARGET_USER=""
MAINTENANCE_TARGET_HOME=""
MAINTENANCE_ROOT_BTRFS_SOURCE=""
MAINTENANCE_ROOT_BTRFS_UUID=""
MAINTENANCE_ROOT_BTRFS_KERNEL_FLAGS=""
MAINTENANCE_CURRENT_KERNEL_PARAMETERS=""
MAINTENANCE_BTRFS_PARTITION_LIST=""
MAINTENANCE_UNMOUNTED_BTRFS_PARTITION_LIST=""
MAINTENANCE_BTRFS_PARTITION_COUNT="0"
MAINTENANCE_BTRFS_DEVICE_LIST=""
MAINTENANCE_BTRFS_MOUNTPOINT_LIST=""
MAINTENANCE_BTRFS_DEVICE_COUNT="0"
