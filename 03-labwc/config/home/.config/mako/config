font=Noto Sans 11
background-color=#111827f2
text-color=#e5e7ebff
width=420
height=220
outer-margin=14,14,0,14
margin=8
padding=12,14
border-size=2
border-color=#6dc4edff
border-radius=14
progress-color=over #f6bd60ff
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/Adwaita:/usr/share/icons/hicolor
icon-border-radius=8
markup=1
actions=1
history=1
max-history=100
sort=-time
group-by=summary,app-name,urgency
format=<b>%s</b>\n%b
hidden-format=<b>%h hidden</b> (%t total)
default-timeout=8000
ignore-timeout=0
max-visible=6
layer=overlay
anchor=top-right
on-button-left=invoke-default-action
on-button-middle=dismiss --no-history
on-button-right=dismiss
on-touch=dismiss

[grouped]
format=<b>%s</b>\n%b\n<small>%g notifications</small>

[hidden]
border-color=#94a3b8ff
progress-color=over #94a3b8ff

[actionable]
border-color=#94d2bdff

[urgency=low]
background-color=#0f1720f2
border-color=#64748bff
default-timeout=5000

[urgency=normal]
background-color=#111827f2
border-color=#6dc4edff
default-timeout=8000

[urgency=critical]
background-color=#2b1116f2
text-color=#fff1f2ff
border-color=#ef4444ff
progress-color=over #ef4444ff
default-timeout=0

[mode=do-not-disturb]
invisible=1
